# Copy to backend/.env and fill in. Never commit the real file.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/brandos?schema=public"

# Session token signing key — generate with: openssl rand -hex 32
JWT_SECRET="CHANGE_ME"

# AES-256 key for encrypting stored integration credentials.
# 64 hex chars are used directly as the key; anything else is SHA-256 hashed.
# Generate with: openssl rand -hex 32
# Rotating this makes already-saved integration credentials unreadable.
ENCRYPTION_KEY="CHANGE_ME"

# BullMQ job queue
REDIS_URL="redis://localhost:6379"

# Exact browser origin allowed to call the API (scheme + host + port)
CORS_ORIGIN="http://localhost:5173"

# API port
PORT=4000

# Optional — enables AI insights. Every other module works without it.
ANTHROPIC_API_KEY=""

# Optional — verifies the x-aramex-signature header on delivery webhooks
ARAMEX_WEBHOOK_SECRET=""
